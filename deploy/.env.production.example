# =============================================================================
# SGE-Y3 — variables d'environnement de PRODUCTION
#
# Ce fichier est un MODÈLE : il ne contient aucun secret réel.
# 1. Copiez-le en .env.production (ignoré par Git) ou collez son contenu
#    directement dans Coolify > votre resource > Environment Variables
#    (bouton "Paste .env" de la vue "Developer").
# 2. Remplacez toutes les valeurs CHANGE_ME_* par des valeurs générées.
#
# Génération des secrets (à exécuter sur votre machine) :
#   openssl rand -hex 24    # MONGO_ROOT_PASSWORD
#   openssl rand -base64 48 | tr -d '\n'   # JWT_SECRET
#
# Ne committez JAMAIS ce fichier une fois rempli.
# =============================================================================

# -----------------------------------------------------------------------------
# Domaine public (Coolify)
# -----------------------------------------------------------------------------
# URL complète, avec le schéma, SANS slash final.
# Exemple : https://sge.votre-domaine.com
# Coolify utilise cette variable pour générer la route Traefik vers le service
# "web" (port 80). Vous pouvez aussi laisser vide et ajouter le domaine depuis
# l'interface Coolify (onglet "Domains" de la resource).
SERVICE_FQDN_WEB=https://sge.example.com

# -----------------------------------------------------------------------------
# MongoDB (conteneur "mongo" du docker-compose)
# -----------------------------------------------------------------------------
# Ces identifiants ne sont appliqués qu'à la CRÉATION du volume mongo-data.
# Les changer ensuite nécessite de recréer le volume (perte de données) ou de
# modifier l'utilisateur dans MongoDB.
MONGO_ROOT_USER=sge
MONGO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# URI utilisée par le backend. Doit reprendre exactement les identifiants
# ci-dessus. Le mot de passe doit être "URL-safe" (utilisez -hex plutôt que
# -base64 pour éviter + / =).
MONGO_URI=mongodb://sge:CHANGE_ME_openssl_rand_hex_24@mongo:27017/sge_y3?authSource=admin

# -----------------------------------------------------------------------------
# Sécurité de l'application
# -----------------------------------------------------------------------------
# Secret de signature des JWT. 48+ caractères aléatoires. En cas de fuite ou de
# changement, tous les utilisateurs connectés sont déconnectés.
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_EXPIRES_IN=24h

# CORS. Les appels du frontend passent par la même origine (Caddy proxifie
# /api), donc CORS n'est pas sollicité et cette variable peut rester vide.
# Si vous la renseignez : URL publique EXACTE, sans slash final
# (ex. https://sge.votre-domaine.com). Plusieurs origines séparées par des virgules.
FRONTEND_URL=

# -----------------------------------------------------------------------------
# Envoi d'e-mails (notifications de soumission d'évaluation)
# -----------------------------------------------------------------------------
# Si SMTP_HOST est vide, les e-mails sont ignorés (avertissement dans les logs)
# au lieu de faire échouer les soumissions.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SGE Y3 <no-reply@example.com>"

# -----------------------------------------------------------------------------
# Build du frontend
# -----------------------------------------------------------------------------
# Chemin de l'API compilé dans le bundle. Laisser "/api" : Caddy route ce
# préfixe vers le backend. Ne mettre une URL absolue que si l'API est servie
# sur un autre domaine.
VITE_API_URL=/api
