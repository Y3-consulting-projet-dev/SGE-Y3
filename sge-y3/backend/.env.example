# SMTP - envoi des notifications email lors des soumissions d'evaluation
# Si SMTP_HOST est vide, les emails sont ignores (avec un avertissement en log) au lieu de planter.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=change_me
SMTP_FROM=notifications@example.com
