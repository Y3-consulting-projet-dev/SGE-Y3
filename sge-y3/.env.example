# Copie ce fichier en ".env" (meme dossier que docker-compose.yml) et renseigne
# de vraies valeurs avant de lancer "docker compose up".

JWT_SECRET=change-moi-avec-une-valeur-longue-et-aleatoire
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:8080

# Optionnel : laisse vide si tu n'utilises pas l'envoi d'emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
